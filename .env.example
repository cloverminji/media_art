# MediaArt Live Sketch - 환경 변수 설정 파일
# 이 파일을 복사하여 .env 파일을 생성하고 실제 Supabase 프로젝트 키를 입력하세요.

PORT=3000

# ----------------------------------------------------
# Supabase Cloud Database & Storage 설정
# Supabase 대시보드 (https://supabase.com) -> Project Settings -> API
# ----------------------------------------------------
# 1. Project URL (예: https://abcdefghijklmn.supabase.co)
SUPABASE_URL=

# 2. Project API Key (anon 또는 service_role 키)
# RLS를 사용하는 경우 service_role 키를 사용하거나, supabase_setup.sql로 설정된 anon 키를 사용합니다.
SUPABASE_KEY=

# 3. Supabase Storage 버킷 명칭 (기본값: mediaart-assets)
SUPABASE_BUCKET=mediaart-assets
